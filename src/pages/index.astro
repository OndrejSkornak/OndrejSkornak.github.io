---
import Base from '../layouts/Base.astro';
import { formatDate, getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <h1 class="visually-hidden">Články</h1>
  {posts.length === 0 && <p class="muted">Zatiaľ tu nič nie je.</p>}
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <a href={`/blog/${post.id}/`}>
            {post.data.title}
            {post.data.draft && <span class="draft">koncept</span>}
          </a>
        </li>
      ))
    }
  </ul>
</Base>
